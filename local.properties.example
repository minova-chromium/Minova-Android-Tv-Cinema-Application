# Copy these values into your existing, ignored local.properties file.
# Keep the sdk.dir entry generated by Android Studio.
sdk.dir=C:/Users/your-name/AppData/Local/Android/Sdk

MINOVA_RELEASE_STORE_FILE=release-signing/minova-cinema-release.jks
MINOVA_RELEASE_STORE_PASSWORD=CHANGE_ME
MINOVA_RELEASE_KEY_ALIAS=minova-cinema
MINOVA_RELEASE_KEY_PASSWORD=CHANGE_ME

# Optional Google Home Cinema Mode build. Install the official Home APIs SDK
# into mavenLocal() first; this build variant requires Android 10 or newer.
MINOVA_HOME_SDK_ENABLED=false
